# ── Aria Security Platform — Environment Variables ───────────────────────────
# Copy to .env.local and fill in your values.
# Generate the encryption key: node scripts/generate-encryption-key.mjs --write

# ── Required: credential encryption ─────────────────────────────────────────
# AES-256-GCM key for connector credentials stored on disk.
# Generate: node scripts/generate-encryption-key.mjs
# REQUIRED in production. Without it, credentials are stored as plaintext.
ARIA_CREDENTIAL_ENCRYPTION_KEY=

# ── AI / LLM — bring your own key ────────────────────────────────────────────
# Aria never ships with keys and never proxies your traffic through us. Every
# provider below is optional; the Intelligence Mode selector in the UI shows
# which engines are actually reachable and greys out the rest.
#
# Cloud reasoning (Anthropic) — the CLOUD mode.
# ANTHROPIC_API_KEY=
# ARIA_CLOUD_MODEL=claude-opus-4-8
#
# Cheap/fast cloud reasoning (Google) — the GEMINI mode.
GEMINI_API_KEY_V2=
GEMINI_MODEL=gemini-2.5-flash

# ── Local / sovereign engine — the LOCAL mode ────────────────────────────────
# Any OpenAI-compatible server works: Ollama, vLLM, LM Studio, llama.cpp,
# text-generation-webui. Nothing leaves your network in this mode.
#
#   ollama serve && ollama pull qwen3:8b
#
# Defaults to Ollama on loopback, so if Ollama is running you need set nothing.
# ARIA_LOCAL_LLM_URL=http://127.0.0.1:11434/v1
#
# Optional. If unset, Aria uses the first model the local server reports, so it
# works with whatever you have already pulled.
# ARIA_LOCAL_LLM_MODEL=qwen3:8b
#
# Some servers (vLLM, LM Studio) want a bearer token even on localhost.
# ARIA_LOCAL_LLM_API_KEY=
#
# Local models on CPU are legitimately slow; raise this if you see timeouts.
# ARIA_LOCAL_LLM_TIMEOUT_MS=45000
#
# Sovereignty guard: Aria refuses to send prompts to a host outside loopback or
# a private range. Only set this if you accept the egress — it defeats the point
# of the LOCAL mode.
# ARIA_LOCAL_LLM_ALLOW_REMOTE=false

# ── Voice (ElevenLabs) ───────────────────────────────────────────────────────
# Optional. Speech-to-text is always local (Whisper via @xenova/transformers);
# only text-to-speech calls out, so leaving this unset keeps voice fully offline
# except for playback, which is then unavailable.
ELEVENLABS_API_KEY=
# Voice ID. Aria's own voice is a private cloned voice and is not shipped; with
# this unset a public ElevenLabs stock voice is used.
ARIAVOICE=
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_CONVERSATION_MODEL=eleven_flash_v2_5
# Optional high-expression mode for non-interactive content only:
# ELEVENLABS_EXPRESSIVE_MODEL=eleven_v3
# ELEVENLABS_OUTPUT_FORMAT=mp3_44100_64
# ARIA_VOICE_WARMUP=true

# ── Server ────────────────────────────────────────────────────────────────────
# development | production. Production is fail-closed: it requires a credential
# encryption key and refuses the built-in demo operator login.
NODE_ENV=development
ARIA_PORT=5000
# Loopback by default — the API is not designed to face the internet.
ARIA_HOST=127.0.0.1
ARIA_PERSISTENCE_DIR=./aria-memory

# ── Auth / tenant defaults (dev only) ────────────────────────────────────────
# In production these should come from a verified JWT. Never set in prod.
ARIA_DEFAULT_TENANT_ID=tenant-local
ARIA_DEFAULT_USER_ID=admin
ARIA_DEFAULT_ROLE=owner
# Set to true to bypass auth header checks on loopback requests (dev only)
# ARIA_AUTHZ_ALLOW_LOCAL_BYPASS=true

# ── Durable KV store (optional) ──────────────────────────────────────────────
# Without these, state resets on restart. Use any Upstash Redis instance.
# ARIA_KV_REST_URL=
# ARIA_KV_REST_TOKEN=

# ── Connector: GitHub ─────────────────────────────────────────────────────────
# Set by the connector UI. Alternatively pre-configure via env vars:
# GITHUB_TOKEN=
# GITHUB_OAUTH_CLIENT_ID=   # for device flow

# ── Connector: AWS ────────────────────────────────────────────────────────────
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1

# ── Connector: Okta ──────────────────────────────────────────────────────────
# OKTA_API_TOKEN=
# OKTA_DOMAIN=yourorg.okta.com

# ── Connector: Snyk ──────────────────────────────────────────────────────────
# SNYK_TOKEN=
# SNYK_ORG_ID=

# ── Connector: Azure AD ───────────────────────────────────────────────────────
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# AZURE_TENANT_ID=

# ── Connector: VirusTotal ────────────────────────────────────────────────────
# VIRUSTOTAL_API_KEY=

# ── Connector: Elastic Security ─────────────────────────────────────────────
# ELASTIC_URL=https://your-cluster:9200
# ELASTIC_API_KEY=
# ELASTIC_KIBANA_URL=https://your-kibana:5601

# ── AWS Secrets Manager (production alternative to local encrypted files) ───
# ARIA_USE_SECRETS_MANAGER=true
# AWS_REGION=us-east-1

# ── Operator login (POST /api/auth/login) ───────────────────────────────────
# Credentials for the login screen. In development, if unset, a built-in demo operator is used:
#   username: operator   password: aria   role: owner
# Production remains fail-closed unless explicit operator credentials are set.
# Single operator override:
# ARIA_LOGIN_USERNAME=operator
# ARIA_LOGIN_PASSWORD=change-me
# ARIA_LOGIN_ROLE=owner          # owner | admin | analyst | viewer
# ARIA_LOGIN_TENANT_ID=tenant-local
# ARIA_LOGIN_USER_ID=user-operator
# Multiple operators (JSON array, overrides the single-operator vars):
# ARIA_OPERATORS=[{"username":"alice","password":"...","role":"admin"},{"username":"bob","password":"...","role":"analyst"}]
# Session lifetime in ms (default 12h):
# ARIA_SESSION_TTL_MS=43200000

# ── Frontend build-time vars (Vite — baked into the bundle, never secrets) ────
# Where the API lives. Empty = same origin; the packaged Electron app defaults
# to http://127.0.0.1:5000.
# VITE_ARIA_API_BASE=
# Endpoint for the landing page's trial/investor forms. No default — the forms
# report "not configured" until you set this. See infra/trial-form/ for a
# deployable AWS SAM reference implementation.
# VITE_TRIAL_ENDPOINT=
# Optional URL for the long-form demo capture on the landing page. The file is
# too large for git, so it is hosted separately; without this the demo section
# falls back to the bundled short clip.
# VITE_DEMO_VIDEO_URL=
