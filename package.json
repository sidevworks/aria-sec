{
  "name": "aria",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "out/main/main.js",
  "scripts": {
    "dev": "vite",
    "start:local": "node scripts/start-local-stack.mjs",
    "aria": "NODE_ENV=development ARIA_ENABLE_DEMO_LOGIN=true node scripts/aria.mjs",
    "start:web": "node scripts/start-web.mjs",
    "start:desktop": "node scripts/aria.mjs",
    "electron:dev": "electron-vite dev",
    "electron:build": "electron-vite build",
    "dist": "npm run electron:build && electron-builder",
    "server": "NODE_ENV=development ARIA_ENABLE_DEMO_LOGIN=true ARIA_PERSISTENCE_DIR=./aria-memory node --env-file-if-exists=.env.local --env-file-if-exists=../.env.local server/index.mjs",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "report:implementation": "node scripts/generate-implementation-report.mjs",
    "bluetooth:registry:update": "node scripts/update-bluetooth-assigned-numbers.mjs",
    "network:vendors:update": "node scripts/update-ieee-oui-registry.mjs",
    "voice:cache": "node --env-file-if-exists=.env.local scripts/cache-whisper-model.mjs",
    "test:ai-spm": "ARIA_PERSISTENCE_DIR=./aria-memory node --test test/server/ai-spm.test.mjs",
    "test:server": "ARIA_PERSISTENCE_DIR=./aria-memory node --test test/server/aria-server-source.test.mjs test/server/policy.test.mjs test/server/identity-routes.test.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock": "^3.1056.0",
    "@aws-sdk/client-bedrock-agent": "^3.1056.0",
    "@aws-sdk/client-cloudtrail": "^3.1056.0",
    "@aws-sdk/client-iam": "^3.1056.0",
    "@aws-sdk/client-lambda": "^3.1056.0",
    "@aws-sdk/client-s3": "^3.1056.0",
    "@aws-sdk/client-secrets-manager": "^3.1056.0",
    "@aws-sdk/client-sts": "^3.1056.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/postprocessing": "^3.0.4",
    "@xenova/transformers": "^2.17.2",
    "gsap": "^3.15.0",
    "leva": "^0.10.1",
    "maath": "^0.10.8",
    "pg": "^8.22.0",
    "postprocessing": "^6.39.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "simplex-noise": "^4.0.3",
    "three": "^0.184.0",
    "ws": "^8.21.0"
  },
  "optionalDependencies": {
    "@stoprocent/noble": "^2.5.9"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "^42.3.3",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "vite": "^7.3.3"
  },
  "build": {
    "appId": "com.aria.desktop",
    "productName": "Aria",
    "files": [
      "out/**",
      "server/**",
      "package.json",
      "!server/scan-records/**",
      "!server/test/**",
      "!server/ENV.md",
      "!server/.DS_Store",
      "!node_modules/**",
      "node_modules/ws/**",
      "node_modules/@stoprocent/noble/**",
      "node_modules/@stoprocent/bluetooth-hci-socket/**",
      "node_modules/@serialport/**",
      "node_modules/serialport/**",
      "node_modules/usb/**",
      "node_modules/node-gyp-build/**",
      "node_modules/node-addon-api/**",
      "node_modules/debug/**",
      "node_modules/ms/**",
      "!out/renderer/audio/**",
      "!out/renderer/landing/media/demo-hq-complete.mp4",
      "!out/renderer/Aria intro.mp4"
    ],
    "asarUnpack": [
      "server/**",
      "!server/scan-records/**",
      "!server/test/**",
      "!server/ENV.md",
      "!server/.DS_Store",
      "node_modules/ws/**",
      "node_modules/@stoprocent/noble/**",
      "node_modules/@stoprocent/bluetooth-hci-socket/**",
      "node_modules/@serialport/**",
      "node_modules/serialport/**",
      "node_modules/usb/**",
      "node_modules/node-gyp-build/**",
      "node_modules/node-addon-api/**",
      "node_modules/debug/**",
      "node_modules/ms/**",
      "out/renderer/aria-demo.mp3",
      "out/renderer/landing/media/**",
      "!out/renderer/landing/media/demo-hq-complete.mp4"
    ],
    "directories": {
      "buildResources": "public",
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Aria can use the microphone for optional local voice features.",
        "NSBluetoothAlwaysUsageDescription": "Aria uses Bluetooth to perform operator-requested local BLE and IoT security discovery. Scan evidence stays on this device."
      }
    }
  }
}
