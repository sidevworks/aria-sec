container_commands:
  01_patch_nginx_cors:
    command: |
      for f in $(find /etc/nginx -name "*.conf" 2>/dev/null); do
        sudo sed -i 's/Access-Control-Allow-Headers.*Content-Type.*/Access-Control-Allow-Headers "Content-Type, Authorization, X-Session-Token, X-Tenant-Id, X-User-Id, X-Role, X-Resource-Tenant";/g' "$f"
      done
      sudo nginx -s reload 2>/dev/null || true
